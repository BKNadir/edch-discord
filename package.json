{
  "name": "edch-discord",
  "version": "0.1.0",
  "private": true,
  "description": "EDCH-Discord: the Discord bot (Cloudflare Worker) that gathers the BGS reports of a squadron's EDCH, stored in the squadron's own Discord server",
  "type": "module",
  "scripts": {
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "commands": "node scripts/register-commands.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.162.0"
  }
}
