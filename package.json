{
  "name": "edch-discord",
  "version": "0.1.0",
  "private": true,
  "description": "EDCH-Discord: the Discord bot that gathers the BGS reports of a squadron's EDCH, stored in the squadron's own Discord server (Cloudflare Worker, or Node on a machine of its own)",
  "type": "module",
  "scripts": {
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/build-factions.mjs && wrangler deploy",
    "update": "node scripts/update.mjs",
    "factions": "node scripts/build-factions.mjs",
    "build:node": "tsc -p tsconfig.node.json",
    "start": "node scripts/server.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.162.0"
  }
}
